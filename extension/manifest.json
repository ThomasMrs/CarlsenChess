{
  "manifest_version": 3,
  "name": "CarlsenChess",
  "version": "1.3.0",
  "description": "Stockfish local, force réglable et meilleurs coups indiqués directement sur votre plateau.",
  "author": "Thomas Marsa",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage", "offscreen"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Ouvrir CarlsenChess", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'" },
  "web_accessible_resources": [{
    "resources": ["content/*.js", "content/panel.css", "vendor/chess.js"],
    "matches": ["http://*/*", "https://*/*"]
  }]
}
